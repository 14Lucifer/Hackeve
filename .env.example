# Copy to .env and change every value marked "change-me" before the first start.

# Deployment mode: "http" (plaintext, no certificate) or "https" (Caddy + free Let's Encrypt certificate)
DEPLOY_MODE=http

# HTTPS mode only: your public domain (DNS A record must point to this server) and an email for certificate notices
DOMAIN=submission.example.com
ACME_EMAIL=you@example.com

# Host ports Caddy listens on
HTTP_PORT=80
HTTPS_PORT=443

# Folder that holds all persistent data (database, uploads, certificates)
DATA_DIR=./data

# Database (use letters and numbers only in the password)
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hackathon

# Session signing key, at least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# First admin account, created on first start only. Change the password later in Admin > Settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
